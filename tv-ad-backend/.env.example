# ---- Step 2: Google Drive (read-only) ----
# The ID is the last part of the folder URL: drive.google.com/drive/folders/<THIS PART>
DRIVE_FOLDER_ID=
# API key from Google Cloud, restricted to the Google Drive API
DRIVE_API_KEY=

# ---- Step 5: OAuth (lets the backend write ads.json, index.html and uploads) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in by "npm run auth"
GOOGLE_REFRESH_TOKEN=

# ---- Admin page login ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Behaviour ----
PORT=8080
IMAGE_DURATION_SEC=60
SYNC_INTERVAL_SEC=300
MAX_UPLOAD_MB=500
# Set to false to scan and preview without writing to Drive
PUBLISH_TO_DRIVE=true
