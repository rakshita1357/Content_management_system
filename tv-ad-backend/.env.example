# ---- Step 2: Google Drive (read-only) ----
# Optional. You can leave this empty and paste a Drive folder link on the admin page instead
# (that choice is remembered and takes priority). The ID is the last part of the folder URL:
# drive.google.com/drive/folders/<THIS PART>
DRIVE_FOLDER_ID=
# Optional. Only needed for "npm run scan" or if you skip OAuth and use a folder shared as
# "Anyone with the link: Viewer". Not used when the OAuth values below are set.
DRIVE_API_KEY=

# ---- Step 5: OAuth (lets the backend write ads.json, index.html and uploads) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in by "npm run auth"
GOOGLE_REFRESH_TOKEN=

# ---- Admin page login ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Behaviour ----
PORT=8080
IMAGE_DURATION_SEC=60
SYNC_INTERVAL_SEC=300
MAX_UPLOAD_MB=500
# Set to true to also save copies of ads.json and index.html in the Drive folder (the TV does not use them)
PUBLISH_TO_DRIVE=false

# ---- Advanced (rarely needed) ----
# Give up on a Google call after this many ms, and how often / how long to wait between repeats
#GOOGLE_TIMEOUT_MS=30000
#GOOGLE_RETRIES=3
#GOOGLE_RETRY_BASE_MS=1000
