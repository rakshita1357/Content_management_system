# Node.js
tv-ad-backend/node_modules/

# Environment variables and secrets
tv-ad-backend/.env
tv-ad-backend/.env.*
!tv-ad-backend/.env.example

# Google OAuth credentials
tv-ad-backend/credentials.json
tv-ad-backend/token.json
tv-ad-backend/client_secret*.json

# Local cache
tv-ad-backend/cache/
tv-ad-backend/data/cache/

# Everything the running backend writes (chosen folder, saved ad list, screens, previews): never commit it
tv-ad-backend/data/*
!tv-ad-backend/data/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db